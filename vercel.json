{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "dashboard",
      "framework": "fastapi",
      "entrypoint": "api.main:app",
      "buildCommand": "cp -r ../sample_data_output1 ./sample_data_output1",
      "functions": {
        "api/main.py": {
          "excludeFiles": "{web/**,views/**,app.py}"
        }
      }
    },
    "web": {
      "root": "dashboard/web",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
